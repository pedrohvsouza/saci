module Saci
  # A pragmatic GraphQL server layer for Crystal's static type system.
  #
  # Schema/type definitions are compile-time classes (no runtime `send`):
  # object types declare a `source`, fields are resolved statically, and
  # argument/type metadata is generated by macros. Queries are parsed and
  # executed at runtime, so clients still get the normal GraphQL document
  # language (variables, aliases, fragments, directives, mutations,
  # introspection and batched requests).
  #
  # ```
  # class UserType < Saci::GraphQL::ObjectType
  #   source User
  #   graphql_name "User"
  #   field :id, Saci::GraphQL::ID, null: false
  #   field :name, String
  #   field :posts, [PostType]
  # end
  #
  # class QueryType < Saci::GraphQL::ObjectType
  #   graphql_name "Query"
  #   field :users, [UserType], null: false do |_source, _args, _ctx|
  #     User.order(id: :asc).to_a
  #   end
  # end
  #
  # class AppSchema < Saci::GraphQL::Schema
  #   query QueryType
  # end
  #
  # AppSchema.execute("{ users { id name } }").to_json
  #
  # router = Saci::Router.new
  # Saci::GraphQL.mount(router, path: "/graphql", schema: AppSchema)
  # ```
  module GraphQL
    VERSION = "0.1.0"

    # Marker type for the built-in GraphQL `ID` scalar. Field/argument type
    # declarations are parsed from the type AST, so this constant exists for
    # call sites that want the familiar `ID` spelling.
    struct ID
    end

    def self.execute(
      schema : Saci::GraphQL::Schema.class,
      query : String,
      *,
      variables : Hash(String, JSON::Any) | JSON::Any | String | Nil = nil,
      operation_name : String? = nil,
      root_value : Saci::GraphQL::Box? = nil,
      request : HTTP::Request? = nil,
      controller : Saci::Controller? = nil,
    ) : Saci::GraphQL::ExecutionResult
      schema.execute(query, variables: variables, operation_name: operation_name,
        root_value: root_value, request: request, controller: controller)
    end

    # Builds the introspection document (`{ __schema { ... } }`) result.
    def self.introspect(schema : Saci::GraphQL::Schema.class) : Saci::GraphQL::ExecutionResult
      schema.execute(Saci::GraphQL::Introspection::QUERY)
    end
  end
end
