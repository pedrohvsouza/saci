require "db"
require "yaml"
require "file_utils"
require "uri"
require "./record"

module Saci
  # Runtime DB-maintenance operations shared by the `saci db:*` commands
  # (G39/G40/G113) and the temporary runners used for PostgreSQL/MySQL.
  #
  # SQLite paths run in-process (the framework already links the sqlite
  # driver); PG/MySQL commands compile a tiny runner that requires the
  # app's driver and calls these same methods, so behavior stays identical.
  #
  # Nothing here boots the web server or requires `src/<app>.cr`: callers
  # connect explicitly with `Saci::Record.connect`.
  module DBTasks
    # A migration file on disk (`db/migrate/<version>_<name>.cr`).
    record MigrationEntry, version : String, name : String, class_name : String

    # Registers every `DATABASE_URL_<NAME>` env var as a named database
    # (same convention as `saci db:migrate --all` / `db/schema:dump --all`).
    def self.register_named_databases! : Nil
      ENV.each do |key, value|
        next unless key.starts_with?("DATABASE_URL_")
        name = key["DATABASE_URL_".size..].downcase
        next if name.empty?
        Saci::Record.establish_connection(name, value)
      rescue ex
        STDERR.puts "warning: could not register #{key}: #{ex.message}"
      end
    end

    # Sorted migration files with their numeric version and derived class
    # name (the same mapping `saci generate migration` writes).
    def self.migration_entries(dir : String = "db/migrate") : Array(MigrationEntry)
      Dir.glob(File.join(dir, "*.cr")).sort.compact_map do |path|
        base = File.basename(path, ".cr")
        m = /\A(\d+)_(.+)\z/.match(base)
        next nil unless m
        name = m[2]
        class_name = name.split("_").map(&.capitalize).join("")
        MigrationEntry.new(m[1], name, class_name)
      end
    end

    # Primary first, then named databases (sorted) with `--all`.
    def self.target_names(all : Bool) : Array(String)
      names = Saci::Record.configuration_names
      primary = names.includes?("primary") ? ["primary"] : [] of String
      primary + (names - ["primary"]).sort
    end

    def self.applied_names(db : DB::Database | DB::Connection) : Array(String)
      Saci::Record::Migrator.applied_names(db)
    end

    # Rails `db:version`: the timestamp of the last applied migration.
    # Returns "0" when nothing ran; falls back to the class name when the
    # migration file no longer exists.
    def self.version_for(applied : Array(String), entries : Array(MigrationEntry)) : String
      return "0" if applied.empty?
      last = applied.last
      entry = entries.find { |e| e.class_name == last }
      entry ? entry.version : last
    end

    def self.print_version(io : IO, name : String, applied : Array(String), entries : Array(MigrationEntry), multi : Bool) : Nil
      prefix = multi ? "[#{name}] " : ""
      io.puts "#{prefix}Current version: #{version_for(applied, entries)}"
    end

    # Rails `db:migrate:status` rows. Applied migrations that no longer
    # have a file on disk are reported as `up` with their class name.
    def self.status_rows(entries : Array(MigrationEntry), applied : Array(String)) : Array(Tuple(MigrationEntry, Bool))
      rows = entries.map { |entry| {entry, applied.includes?(entry.class_name)} }
      known = entries.map(&.class_name).to_set
      applied.each do |name|
        next if known.includes?(name)
        rows << {MigrationEntry.new("??????????????", name, name), true}
      end
      rows
    end

    def self.print_status(io : IO, name : String, entries : Array(MigrationEntry), applied : Array(String), multi : Bool) : Nil
      io.puts "database: #{name}" if multi
      io.puts ""
      io.puts " Status   Migration ID    Migration Name"
      io.puts "-" * 56
      status_rows(entries, applied).each do |(entry, up)|
        io.puts "  #{up ? "up" : "down"}     #{entry.version.ljust(14)}  #{entry.class_name}"
      end
      io.puts ""
    end

    # Schema-cache snapshot (Rails `db:schema:cache:dump` equivalent).
    # The file is plain YAML so it can be committed and inspected offline.
    def self.schema_cache_content(names : Array(String) = ["primary"]) : String
      String.build do |io|
        io.puts "# Schema cache generated by `saci db:schema:cache:dump` (#{Time.utc.to_rfc3339})."
        io.puts "# Plain YAML, safe to commit; regenerate after migrations."
        io.puts "version: 1"
        io.puts "databases:"
        names.each do |name|
          tables = Saci::Record::Schema.introspect(Saci::Record.database(name))
          io.puts "  #{name.inspect}:"
          io.puts "    tables:"
          tables.each do |table|
            io.puts "      #{table.name.inspect}:"
            io.puts "        columns:"
            table.columns.each do |column|
              io.puts "          - name: #{column.name.inspect}"
              io.puts "            type: #{column.logical_type.to_s.inspect}"
              io.puts "            null: #{column.null}"
              io.puts "            primary: #{column.primary_key}"
            end
            io.puts "        timestamps: #{table.timestamps}"
            io.puts "        indexes:"
            table.indexes.each do |index|
              io.puts "          - name: #{index.name.inspect}"
              io.puts "            columns: [#{index.columns.map(&.inspect).join(", ")}]"
              io.puts "            unique: #{index.unique}"
            end
          end
        end
      end
    end

    def self.write_schema_cache(path : String = "db/schema_cache.yml", names : Array(String) = ["primary"]) : Nil
      Dir.mkdir_p(File.dirname(path))
      File.write(path, schema_cache_content(names))
    end

    # -- fixtures ----------------------------------------------------------

    # Loads YAML fixtures from `dir` (default resolution in the CLI:
    # `spec/fixtures` then `test/fixtures`). Each file maps to a table;
    # files in subdirectories join the path with underscores
    # (`admin/users.yml` -> `admin_users`). Existing rows in each touched
    # table are deleted first (Rails fixture semantics).
    def self.load_fixtures(db : DB::Database | DB::Connection, dir : String, io : IO = STDOUT) : Int32
      files = Dir.glob(File.join(dir, "**", "*.yml")).sort +
              Dir.glob(File.join(dir, "**", "*.yaml")).sort
      base_dir = dir.ends_with?("/") ? dir[0...-1] : dir
      table_columns = {} of String => Array(String)
      total = 0
      files.each do |file|
        rel = file.sub(base_dir + "/", "").sub(/\.ya?ml$/, "")
        table = rel.gsub("/", "_")
        raw = YAML.parse(File.read(file))
        rows = raw.as_h?
        next unless rows
        ad = Saci::Record.adapter_of(db)
        Saci::Record.exec_compat(db, "DELETE FROM #{Saci::Record.quote(table, ad)}")
        columns = table_columns[table]? || begin
          info = Saci::Record::Schema.introspect(db).find { |t| t.name == table }
          cols = info ? info.columns.map(&.name) : [] of String
          # Schema.introspect folds `timestamps` into a flag; the raw
          # columns list omits created_at/updated_at in that case.
          if info && info.timestamps
            cols << "created_at" unless cols.includes?("created_at")
            cols << "updated_at" unless cols.includes?("updated_at")
          end
          table_columns[table] = cols
          cols
        end
        count = 0
        rows.each do |_label, attrs|
          fields = attrs.as_h?
          next unless fields
          names = fields.keys.map(&.to_s)
          values = fields.values.map { |value| fixture_value(value) }
          # Rails fixtures fill timestamps through Active Record; this raw
          # loader does the same for conventional timestamp columns.
          now = Time.utc
          if columns.includes?("created_at") && !names.includes?("created_at")
            names << "created_at"
            values << now
          end
          if columns.includes?("updated_at") && !names.includes?("updated_at")
            names << "updated_at"
            values << now
          end
          placeholders = Array.new(names.size, "?").join(", ")
          sql = "INSERT INTO #{Saci::Record.quote(table, ad)} (#{names.map { |c| Saci::Record.quote(c, ad) }.join(", ")}) VALUES (#{placeholders})"
          Saci::Record.exec_compat(db, sql, values)
          count += 1
        end
        total += count
        io.puts "Loaded #{count} record#{count == 1 ? "" : "s"} into #{table} from #{file}"
      end
      io.puts "No fixture files found in #{dir}." if files.empty?
      total
    end

    private def self.fixture_value(value : YAML::Any) : Saci::Record::Value
      case raw = value.raw
      when Nil, String, Int64, Float64, Bool then raw
      when Time                              then raw
      when Array(YAML::Any), Hash(YAML::Any, YAML::Any), Set(YAML::Any)
        value.to_json
      else
        raw.to_s
      end
    end

    # -- truncation --------------------------------------------------------

    # Deletes every row from every table except `schema_migrations`
    # (named databases included when `all` is true). Returns the number of
    # tables touched.
    def self.clean_databases!(all : Bool = false) : Int32
      total = 0
      target_names(all).each { |name| total += clean_database!(Saci::Record.database(name)) }
      total
    end

    def self.clean_database!(db : DB::Database | DB::Connection) : Int32
      adapter = Saci::Record.adapter_of(db)
      list_sql = case adapter
                 when :postgres then "SELECT tablename FROM pg_tables WHERE schemaname = 'public' AND tablename != 'schema_migrations'"
                 when :mysql    then "SELECT table_name FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name != 'schema_migrations'"
                 else                "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' AND name != 'schema_migrations'"
                 end
      tables = [] of String
      Saci::Record.query_compat(db, list_sql) { |rs| rs.each { tables << rs.read(String) } }
      tables.each { |table| Saci::Record.exec_compat(db, "DELETE FROM #{Saci::Record.quote(table, adapter)}") }
      tables.size
    end

    # -- create / drop -----------------------------------------------------

    # Path behind a `sqlite3://` URL (query parameters stripped).
    def self.sqlite_path(url : String) : String
      raise ArgumentError.new("Not a SQLite URL: #{url.inspect}") unless Saci::Record.adapter_for_url(url) == :sqlite
      rest = url.split("://", 2)[1]? || ""
      rest.split("?", 2)[0]
    end

    def self.database_name(url : String) : String
      uri = URI.parse(url)
      name = uri.path.lchop("/")
      name.empty? ? uri.host.to_s : name
    end

    # Creates the database when missing. Returns true when it was created
    # (false when it already existed). SQLite touches the DB file; PG/MySQL
    # connect to the maintenance database and issue CREATE DATABASE.
    def self.create_database(url : String) : Bool
      case Saci::Record.adapter_for_url(url)
      when :sqlite
        path = sqlite_path(url)
        return false if path.empty? || path == ":memory:" || File.exists?(path)
        parent = File.dirname(path)
        Dir.mkdir_p(parent) unless parent == "." || parent.empty?
        File.open(path, "a") { }
        true
      when :postgres
        create_remote(url, "postgres", :postgres)
      when :mysql
        create_remote(url, "/", :mysql)
      else
        raise ArgumentError.new("Unsupported adapter for #{url.inspect}")
      end
    end

    def self.drop_database(url : String) : Bool
      case Saci::Record.adapter_for_url(url)
      when :sqlite
        path = sqlite_path(url)
        existed = File.exists?(path)
        if existed
          File.delete(path)
          ["#{path}-wal", "#{path}-shm"].each { |extra| File.delete(extra) if File.exists?(extra) }
        end
        existed
      when :postgres
        drop_remote(url, "postgres", :postgres)
        true
      when :mysql
        drop_remote(url, "/", :mysql)
        true
      else
        raise ArgumentError.new("Unsupported adapter for #{url.inspect}")
      end
    end

    private def self.create_remote(url : String, maintenance_path : String, adapter : Symbol) : Bool
      name = database_name(url)
      uri = URI.parse(url)
      uri.path = maintenance_path
      DB.open(uri.to_s) do |db|
        begin
          db.exec("CREATE DATABASE #{quote_identifier(name, adapter)}")
          true
        rescue ex : DB::Error
          return false if already_exists?(ex.message)
          raise ex
        end
      end
    end

    private def self.drop_remote(url : String, maintenance_path : String, adapter : Symbol) : Nil
      name = database_name(url)
      uri = URI.parse(url)
      uri.path = maintenance_path
      DB.open(uri.to_s) do |db|
        db.exec("DROP DATABASE IF EXISTS #{quote_identifier(name, adapter)}")
      end
    end

    private def self.quote_identifier(name : String, adapter : Symbol) : String
      if adapter == :mysql
        "`#{name.gsub("`", "``")}`"
      else
        "\"#{name.gsub("\"", "\"\"")}\""
      end
    end

    private def self.already_exists?(message : String?) : Bool
      text = message || ""
      text.includes?("already exists") || text.includes?("Duplicate database name")
    end
  end
end
