module Saci
  module Mailer
    # Proxy returned by `SomeMailer.with(user: user)`. The action is resolved
    # when called (`.welcome`) and the params are visible through `params`
    # inside the mail method.
    class Parameterized
      getter params : Params

      def initialize(@params : Params, @resolver : Proc(String, Mail))
      end

      # Resolver helpers: only zero-argument class methods that actually
      # return a `Mail` can be actions; other helpers are rejected at call
      # time instead of failing to compile.
      def self.coerce(mail : Mail) : Mail
        mail
      end

      def self.coerce(other) : Mail
        raise ArgumentError.new("method returned #{other.class}, not Saci::Mailer::Mail")
      end

      # Parameterized mailer actions are deliberately zero-argument: values
      # flow through `with(...)`. `method_missing` resolves the action against
      # the concrete mailer class (the resolver is generated by `Base.with`).
      macro method_missing(call)
        {% if call.args.size > 0 || call.named_args %}
          raise ArgumentError.new("parameterized mailer actions take no arguments; use .with(...)")
        {% else %}
          Saci::Mailer::Context.with_params(@params, {{call.name.stringify}}) do
            @resolver.call({{call.name.stringify}})
          end
        {% end %}
      end
    end

    class Base
      # `UserMailer.with(user: user).welcome` — builds the mail with params
      # available as `params`. Actions must be zero-argument class methods
      # (`def self.welcome`); actions with positional arguments keep using the
      # normal class-method call style.
      macro with(**params)
        Saci::Mailer::Parameterized.new(
          Saci::Mailer::Params.new(
            ({\
            {% for key, value in params %}\
              {{key.stringify}} => Saci::Mailer::Params.any({{value}}),\
            {% end %}\
            } of String => ::JSON::Any)
          ),
          ->(action : String) {
            case action
            {% for method in @type.class.methods %}\
              {% skip = ["allocate", "with", "mail", "attachments", "headers", "params", "action_name", "current_mail", "deliver", "default_from_address", "default_reply_to_address", "mailer_layout_name"] %}\
              {% if !skip.includes?(method.name.stringify) && !method.name.stringify.starts_with?("__saci") && method.args.empty? && method.block_arg.nil? %}\
              when "{{method.name}}"
                Saci::Mailer::Parameterized.coerce({{@type}}.{{method.name}})
              {% end %}\
            {% end %}\
            else
              raise ArgumentError.new("Unknown parameterized mailer action #{action} for {{@type.name}}")
            end
          }
        )
      end
    end
  end
end
