module Saci
  module Record
    # Raised by `accepts_nested_attributes_for ... limit:` when more new
    # records are submitted than the association allows (Rails:
    # `ActiveRecord::NestedAttributes::TooManyRecords`).
    class TooManyRecords < Exception
    end

    # Form params arrive as nested hashes with string keys; direct Crystal
    # calls usually use symbol-keyed named tuples. Both shapes are normalized
    # to `Hash(String, Saci::Record::Value)` here.
    #
    # Documented params shape (view-side `fields_for` equivalent):
    #
    # ```
    # {
    #   "post" => {
    #     "title"               => "Hello",
    #     "comments_attributes" => [
    #       {"body" => "first"},               # create
    #       {"id" => "7", "body" => "edited"}, # update
    #       {"id" => "8", "_destroy" => "1"},  # destroy
    #     ],
    #   },
    # }
    # ```
    #
    # `Saci::Params` exposes the same tree through `Params::Value#as_a` /
    # `#as_h`; pass the resulting hashes to the setter with
    # `post.comments_attributes = params.require(:post)["comments_attributes"].as_a.map(&.as_h)`
    # (or mass-assign `Post.new(comments_attributes: [...])`). `fields_for`
    # itself is view-side and is not generated by this macro.

    def self.nested_hash(value : Object) : Hash(String, Saci::Record::Value)
      case value
      when NamedTuple
        h = {} of String => Saci::Record::Value
        value.each { |k, v| h[k.to_s] = nested_value(v) }
        h
      when Hash
        h = {} of String => Saci::Record::Value
        value.each { |k, v| h[k.to_s] = nested_value(v) }
        h
      else
        raise ArgumentError.new("nested attributes expect a Hash or NamedTuple (got #{value.class})")
      end
    end

    # Accepts an array of hashes, a single hash, an index-keyed hash
    # (`{"0" => {...}, "1" => {...}}`, the Rails form params shape) or a
    # named tuple.
    def self.attrs_list(value : Array) : Array(Hash(String, Saci::Record::Value))
      value.map { |v| nested_hash(v) }
    end

    def self.attrs_list(value : Hash) : Array(Hash(String, Saci::Record::Value))
      keys = value.keys
      if !keys.empty? && keys.all? { |k| k.to_s.matches?(/\A\d+\z/) }
        value.values.map { |v| nested_hash(v) }
      else
        [nested_hash(value)]
      end
    end

    def self.attrs_list(value : NamedTuple) : Array(Hash(String, Saci::Record::Value))
      [nested_hash(value)]
    end

    # `_destroy` values from forms are strings ("1"/"true") or booleans.
    def self.nested_truthy?(value : Object) : Bool
      case value
      when Nil    then false
      when Bool   then value
      when String then !{"", "0", "false", "f", "no", "n"}.includes?(value.strip.downcase)
      when Number then value != 0
      else             !nested_blank?(value)
      end
    end

    # Rails `blank?` over an untyped params value (used by `all_blank`).
    def self.nested_blank?(value : Object) : Bool
      case value
      when Nil    then true
      when Bool   then !value
      when String then value.strip.empty?
      when Array  then value.empty?
      when Hash   then value.empty?
      else             false
      end
    end

    # Reject rule `:all_blank`: every submitted attribute besides `id` and
    # `_destroy` is blank.
    def self.nested_all_blank?(attrs : Hash(String, Saci::Record::Value)) : Bool
      attrs.all? do |key, value|
        key == "id" || key == "_destroy" || nested_blank?(value)
      end
    end

    # Coerces a params value into the `Value` union used by column setters.
    # Nested-nested attributes are intentionally unsupported (Crystal has no
    # runtime method dispatch); the error names the offending shape.
    def self.nested_value(value : Object) : Value
      case value
      when Nil           then nil
      when String        then value
      when Int32         then value
      when Int64         then value
      when Float32       then value
      when Float64       then value
      when Bool          then value
      when Time          then value
      when Bytes         then value
      when BigDecimal    then value
      when Array(String) then value
      when Symbol        then value.to_s
      when Int           then value.to_i64
      when Float         then value.to_f64
      when Array
        raise ArgumentError.new("nested attributes inside nested attributes are not supported (got an Array)")
      when Hash
        raise ArgumentError.new("nested attributes inside nested attributes are not supported (got a Hash)")
      when NamedTuple
        raise ArgumentError.new("nested attributes inside nested attributes are not supported (got a NamedTuple)")
      else
        value.to_s
      end
    end

    # Primary-key params arrive as strings from forms; integer-looking ids
    # are converted so PostgreSQL can bind them to bigint columns.
    def self.nested_id_value(value : Object) : Value
      case value
      when String
        value.to_i64? || value
      when Symbol
        value.to_s
      when Nil
        nil
      else
        nested_value(value)
      end
    end

    # Shared implementation behind every generated
    # `<assoc>_attributes=` setter. Works with any target class through the
    # `AssocMeta` procs registered by the association macros.
    def self.assign_nested_attributes(record : Base, assoc : String,
                                      list : Array(Hash(String, Saci::Record::Value)),
                                      allow_destroy : Bool, reject_all_blank : Bool,
                                      limit : Int32, update_only : Bool,
                                      pending : Array(Base),
                                      destroying : Array(Base)) : Nil
      meta = record.class.__saci_assoc_meta(assoc)
      raise ArgumentError.new("accepts_nested_attributes_for #{assoc}: unknown association on #{record.class}") if meta.nil?
      kind = meta.kind
      unless kind == :has_many || kind == :has_one || kind == :belongs_to
        raise ArgumentError.new("accepts_nested_attributes_for #{assoc}: association kind #{kind} is not supported (has_many/has_one/belongs_to only)")
      end
      factory = meta.factory
      raise ArgumentError.new("accepts_nested_attributes_for #{assoc}: no target factory registered") if factory.nil?
      owner_pk = record.__saci_get_attr(record.class.__saci_primary_key)
      created = 0

      list.each do |attrs|
        id_raw = attrs["id"]?
        destroy = nested_truthy?(attrs["_destroy"]?)
        clean = attrs.reject { |k, _| k == "id" || k == "_destroy" }

        if id_raw
          child = meta.finder.not_nil!.call(nested_id_value(id_raw))
          # A submitted id must belong to this owner; otherwise Rails raises
          # RecordNotFound instead of silently stealing a row.
          if (kind == :has_many || kind == :has_one) && (fk = meta.foreign_key)
            child_fk = child.__saci_get_attr(fk)
            if !owner_pk.nil? && child_fk.to_s != owner_pk.to_s
              raise RecordNotFound.new("Couldn't find #{child.class} with id=#{id_raw} for #{record.class}##{assoc}")
            end
          end
          if destroy && allow_destroy
            pending.reject! { |c| c.same?(child) }
            destroying << child unless child.new_record?
            next
          end
          assign_nested_attrs(child, clean)
          pending.reject! { |c| c.same?(child) }
          pending << child
          next
        end

        next if destroy
        next if reject_all_blank && nested_all_blank?(attrs)

        existing = (kind == :has_one || kind == :belongs_to) ? record.__saci_assoc_current(assoc).first? : nil
        if existing
          if update_only
            assign_nested_attrs(existing, clean)
            pending.reject! { |c| c.same?(existing) }
            pending << existing
            next
          elsif kind == :has_one
            # has_one without update_only replaces the current row.
            pending.reject! { |c| c.same?(existing) }
            destroying << existing unless existing.new_record?
          end
        end

        created += 1
        if limit > 0 && created > limit
          raise TooManyRecords.new("more than #{limit} #{assoc} are submitted for #{record.class}")
        end
        child = factory.call
        assign_nested_attrs(child, clean)
        # Persisted owners can stamp the child foreign key immediately (the
        # column is visible to validations). New owners get it after INSERT.
        if !owner_pk.nil? && (kind == :has_many || kind == :has_one) && (fk = meta.foreign_key)
          child.__saci_set_attr(fk, owner_pk)
        end
        pending.reject! { |c| c.same?(child) }
        pending << child
      end
    end

    private def self.assign_nested_attrs(child : Base, attrs : Hash(String, Saci::Record::Value)) : Nil
      attrs.each do |key, value|
        unless child.__saci_set_attr(key, nested_value(value))
          raise UnknownAttributeError.new("unknown attribute '#{key}' for #{child.class}")
        end
      end
    end
  end

  class Record::Base
    # Rails-style nested attributes (G19).
    #
    # ```
    # class Post < Saci::Record::Base
    #   has_many :comments
    #   accepts_nested_attributes_for :comments, allow_destroy: true,
    #     reject_if: :all_blank, limit: 10
    # end
    #
    # Post.create!(title: "Hi", comments_attributes: [{body: "first"}])
    # post.comments_attributes = [{"id" => "7", "body" => "edited"}]
    # post.comments_attributes = [{"id" => "8", "_destroy" => "1"}]
    # ```
    #
    # Children are validated with the parent (`errors["comments"]` gets
    # `"is invalid"`), and the owner plus all children are written in one
    # transaction. `has_many :through`/HABTM targets are not supported (Rails
    # requires `accepts_nested_attributes_for` on the join model).
    #
    # `update_only: true` reuses an existing `has_one`/`belongs_to` child
    # instead of replacing it. `reject_if: :all_blank` drops submissions whose
    # only non-blank values are `id`/`_destroy`. Form params use the shape
    # documented on `Saci::Record.attrs_list`.
    macro accepts_nested_attributes_for(name, allow_destroy = false, reject_if = nil, limit = nil, update_only = false)
      {% n = name.id.stringify %}
      {% reject_all_blank = reject_if.is_a?(SymbolLiteral) && reject_if.id.stringify == "all_blank" %}
      {% if reject_if && !reject_all_blank %}
        {% raise "accepts_nested_attributes_for #{name}: only reject_if: :all_blank is supported (got #{reject_if})" %}
      {% end %}
      {% lim = limit.is_a?(NilLiteral) ? 0 : limit %}

      @__saci_nested_{{name.id}} : Array(Saci::Record::Base) = [] of Saci::Record::Base
      @__saci_nested_destroy_{{name.id}} : Array(Saci::Record::Base) = [] of Saci::Record::Base

      def {{name.id}}_attributes=(values : Array | Hash | NamedTuple) : Nil
        Saci::Record.assign_nested_attributes(
          self, {{n}}, Saci::Record.attrs_list(values),
          {{allow_destroy}}, {{reject_all_blank}}, {{lim}}, {{update_only}},
          @__saci_nested_{{name.id}}, @__saci_nested_destroy_{{name.id}})
      end

      # Mass-assignment bridge: `Post.new({{name.id}}_attributes: [...])`.
      def __saci_set_nested_attributes(name : String, value : Object) : Bool
        if name == {{n + "_attributes"}}
          case value
          when Array, Hash, NamedTuple
            self.{{name.id}}_attributes = value
          else
            raise ArgumentError.new("#{ {{n}} }_attributes expects an Array/Hash/NamedTuple (got #{value.class})")
          end
          return true
        end
        previous_def
      end

      def __saci_assoc_writes_pending? : Bool
        previous_def || !@__saci_nested_{{name.id}}.empty? || !@__saci_nested_destroy_{{name.id}}.empty?
      end

      def __saci_assoc_validate(errors : Saci::Record::Errors) : Nil
        previous_def
        %invalid = false
        @__saci_nested_{{name.id}}.each do |%child|
          %invalid = true unless %child.valid?
        end
        errors.add({{n}}, "is invalid") if %invalid
      end

      def __saci_assoc_write_before : Nil
        previous_def
        %meta = self.class.__saci_assoc_meta({{n}})
        return if %meta.nil?
        if %meta.kind == :belongs_to
          %fk = %meta.foreign_key
          @__saci_nested_{{name.id}}.each do |%child|
            %child.save || raise Saci::Record::RecordNotSaved.new("Failed to save nested #{ {{n}} } record")
            %child_pk = %child.__saci_get_attr(%child.class.__saci_primary_key)
            __saci_set_attr(%fk, %child_pk) if %fk && !%child_pk.nil?
          end
          # _destroy on belongs_to nulls the owner FK first; the child row is
          # removed after the owner UPDATE (avoids an immediate FK violation).
          @__saci_nested_destroy_{{name.id}}.each do |_child|
            __saci_set_attr(%fk, nil) if %fk
          end
        end
      end

      def __saci_assoc_write_after : Nil
        previous_def
        %meta = self.class.__saci_assoc_meta({{n}})
        if %meta
          if %meta.kind != :belongs_to
            %owner_pk = __saci_get_attr(self.class.__saci_primary_key)
            %fk = %meta.foreign_key
            @__saci_nested_{{name.id}}.each do |%child|
              %child.__saci_set_attr(%fk, %owner_pk) if %fk && !%owner_pk.nil?
              %child.save || raise Saci::Record::RecordNotSaved.new("Failed to save nested #{ {{n}} } record")
            end
          end
          @__saci_nested_destroy_{{name.id}}.each { |%child| %child.destroy }
        end
        @__saci_nested_{{name.id}}.clear
        @__saci_nested_destroy_{{name.id}}.clear
      end
    end
  end
end
