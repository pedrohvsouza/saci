module Saci
  module Testing
    # Process-level parallel test support.
    #
    # Crystal's `crystal spec` runner executes a single process and has no
    # built-in worker pool, so real parallelism means running one `crystal
    # spec` process per worker (via `bin/ci`, `xargs -P`, CI matrix, …).
    # Each worker gets its own SQLite file (`app_test_0.db`, `app_test_1.db`,
    # …) because concurrent writers against one SQLite file corrupt WAL —
    # as observed in the framework's own suite. This module provides the
    # database plumbing and command/shard helpers; it deliberately does not
    # patch the stdlib runner.
    #
    # Convention: every worker process is started with
    # `SACI_TEST_WORKER=<index>`; `Saci::Testing.parallelize(workers: 4)`
    # then opens `<base>_<index>.db` instead of the shared base database.
    #
    # ```
    # # spec/spec_helper.cr
    # Spec.before_suite do
    #   Saci::Testing.parallelize(workers: 4)
    # end
    # ```
    #
    # Create the worker databases once (no `SACI_TEST_WORKER`) and generate
    # a CI script:
    #
    # ```
    # plan = Saci::Testing.parallelize(workers: 4, spec_files: Dir.glob("spec/**/*_spec.cr"))
    # plan.write_ci_script("bin/ci-parallel")
    # ```
    class ParallelPlan
      getter workers : Int32
      getter base_url : String
      getter database_urls : Array(String)
      getter spec_files : Array(String)

      def initialize(@workers : Int32, @base_url : String, @database_urls : Array(String), @spec_files : Array(String))
      end

      def database_url_for(index : Int32) : String
        @database_urls[index] ||
          raise ArgumentError.new("No database URL for worker #{index} (workers: #{@workers})")
      end

      # Round-robin distribution of spec files across workers.
      def shards : Array(Array(String))
        buckets = Array(Array(String)).new(@workers) { [] of String }
        @spec_files.each_with_index { |file, index| buckets[index % @workers] << file }
        buckets
      end

      def each_worker(& : Int32, String ->) : Nil
        @workers.times { |index| yield index, database_url_for(index) }
      end

      # Shell commands that run each shard in its own process.
      def commands(spec_binary : String = "crystal spec") : Array(String)
        shards.map_with_index do |files, index|
          files.empty? ? nil : "SACI_TEST_WORKER=#{index} #{spec_binary} #{files.join(" ")}"
        end.compact
      end

      # A `bin/ci`-friendly script that runs every shard concurrently and
      # exits non-zero if any worker fails.
      def ci_script(spec_binary : String = "crystal spec") : String
        lines = [] of String
        lines << "#!/usr/bin/env bash"
        lines << "# Generated by Saci::Testing::ParallelPlan#ci_script"
        lines << "set -uo pipefail"
        lines << "cd \"$(dirname \"$0\")/..\""
        lines << "pids=()"
        commands(spec_binary).each do |command|
          lines << "#{command} &"
          lines << "pids+=(\"$!\")"
        end
        lines << "status=0"
        lines << "for pid in \"${pids[@]}\"; do"
        lines << "  wait \"$pid\" || status=1"
        lines << "done"
        lines << "exit \"$status\""
        lines.join("\n") + "\n"
      end

      def write_ci_script(path : String, spec_binary : String = "crystal spec") : String
        File.write(path, ci_script(spec_binary))
        File.chmod(path, 0o755)
        path
      end
    end

    # Index of the current process's worker (`SACI_TEST_WORKER`, default 0).
    def self.worker_index : Int32
      ENV["SACI_TEST_WORKER"]?.try(&.to_i?) || 0
    end

    def self.worker_env? : Bool
      !ENV["SACI_TEST_WORKER"]?.nil?
    end

    # `sqlite3://./db/app_test.db` → `sqlite3://./db/app_test_0.db`.
    def self.worker_database_url(base_url : String, index : Int32) : String
      path = sqlite_path_from_url(base_url)
      unless path
        raise ArgumentError.new("Saci::Testing.parallelize only clones sqlite3:// databases (got #{base_url}); use separate databases per worker for PostgreSQL/MySQL instead")
      end
      dir = File.dirname(path).sub(/^\.\//, "")
      basename = File.basename(path)
      stem = basename.ends_with?(".db") ? basename[0...-3] : basename
      worker_path = (dir.empty? || dir == ".") ? "#{stem}_#{index}.db" : File.join(dir, "#{stem}_#{index}.db")
      sqlite_url_for(worker_path)
    end

    # Prepares the shared base database and clones it for every worker.
    # Returns the plan (which can generate commands/scripts).
    def self.prepare_parallel_databases!(workers : Int32, base_url : String? = nil,
                                         spec_files : Array(String)? = nil) : ParallelPlan
      workers = workers.clamp(1, 64)
      base_url = base_url || database_url
      urls = (0...workers).map { |index| worker_database_url(base_url, index) }
      files = spec_files || Dir.glob("spec/**/*_spec.cr").sort
      plan = ParallelPlan.new(workers, base_url, urls, files)

      db = prepare_database!(base_url)
      if path = sqlite_path_from_url(base_url)
        checkpoint_sqlite!(db)
        urls.each do |url|
          if worker_path = sqlite_path_from_url(url)
            delete_worker_files(worker_path)
            File.copy(path, worker_path)
          end
        end
      end
      plan
    end

    # Entry point for spec helpers. Without `SACI_TEST_WORKER` it prepares
    # the base database and worker clones; with it, the current process uses
    # (and prepares) only its own worker database.
    def self.parallelize(workers : Int32 = 4, base_url : String? = nil,
                         spec_files : Array(String)? = nil) : ParallelPlan
      workers = workers.clamp(1, 64)
      base_url = base_url || database_url

      if worker_env?
        index = worker_index
        if index < 0 || index >= workers
          raise ArgumentError.new("SACI_TEST_WORKER=#{index} is out of range for workers=#{workers}")
        end
        urls = (0...workers).map { |i| worker_database_url(base_url, i) }
        files = spec_files || Dir.glob("spec/**/*_spec.cr").sort
        plan = ParallelPlan.new(workers, base_url, urls, files)
        ensure_worker_database!(base_url, urls[index])
        prepare_database!(urls[index])
        plan
      else
        prepare_parallel_databases!(workers, base_url, spec_files)
      end
    end

    # Ensures `worker_url` exists, copying the base file when necessary.
    def self.ensure_worker_database!(base_url : String, worker_url : String) : Nil
      worker_path = sqlite_path_from_url(worker_url)
      return unless worker_path
      return if File.exists?(worker_path)

      base_path = sqlite_path_from_url(base_url)
      raise ArgumentError.new("Saci::Testing.parallelize: no base SQLite file at #{base_path} to clone") unless base_path
      unless File.exists?(base_path)
        # Last resort for a worker started without a prior prepare pass.
        prepare_database!(base_url)
      end
      checkpoint_sqlite!(Record.database("primary"))
      File.copy(base_path, worker_path)
    end

    # Flushes the WAL into the main database file before copying.
    def self.checkpoint_sqlite!(db : DB::Database) : Nil
      Record.exec_compat(db, "PRAGMA wal_checkpoint(TRUNCATE)")
    rescue
      # Non-SQLite or checkpoint unsupported; file copy is still best-effort.
    end

    private def self.delete_worker_files(path : String) : Nil
      [path, "#{path}-wal", "#{path}-shm"].each do |file|
        File.delete(file) if File.exists?(file)
      rescue
        # Best effort.
      end
    end
  end
end
