<h1><%= h(article.title || "") %></h1>
<p>score: <%= article.score %></p>
<div><%= h(article.body || "") %></div>
<h3>Comments (<%= comments.size %>)</h3>
<% comments.each do |c| %>
<p class="comment"><%= h(c.body || "") %></p>
<% end %>
<%= render_partial("shared/lite_guidelines") %>
<p><%= link_to("Delete", "/lite_articles/#{article.id}", method: :delete) %></p>
